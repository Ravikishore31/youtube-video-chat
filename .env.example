# Copy this file to .env and add your own keys, or enter them in the sidebar.
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# Defaults match the reference RAG code. Change them to models your keys can access.
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
GEMINI_MODEL=gemini-3.5-flash

# Optional: absolute or relative directory for persisted transcript embeddings.
# Relative paths are resolved against the application directory.
CHROMA_DIR=data/chroma

# For public sharing, require each visitor to provide their own provider keys.
REQUIRE_USER_KEYS=false

# Optional: configure a proxy if YouTube blocks your hosting provider's IP.
# YOUTUBE_PROXY_URL=http://username:password@host:port
